# ============================================================
# Configuracoes de Email (SMTP - envio)
# ============================================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=suporte@suaempresa.com
EMAIL_HOST_PASSWORD=sua_senha_de_app_gmail

# ============================================================
# Configuracoes IMAP (leitura de emails recebidos)
# O sistema verifica a caixa a cada 5 minutos via Celery Beat
# e converte emails nao lidos em chamados automaticamente.
#
# Gmail: EMAIL_IMAP_HOST=imap.gmail.com (porta 993)
# Outlook: EMAIL_IMAP_HOST=outlook.office365.com (porta 993)
# Para Gmail, use uma App Password:
#   myaccount.google.com > Seguranca > Senhas de app
# ============================================================
EMAIL_IMAP_ENABLED=True
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USE_SSL=True
EMAIL_IMAP_USER=suporte@suaempresa.com
EMAIL_IMAP_PASSWORD=sua_senha_de_app_gmail
EMAIL_IMAP_FOLDER=INBOX
