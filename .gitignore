*.py[cod]
venv/
env/
.venv/
db.sqlite3
db.sqlite3-journal

# Node
node_modules/
.next/
npm-debug.log*

# Ambiente / segredos
.env
.env.local
.env.*.local

# IDE / SO
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
